---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Libringo - Lectura entre amigos"
  description="Construye un hábito diario de lectura con Libringo: lectura entre amigos. Mantén tu racha de días, compite con amigos y no leas nunca más en soledad."
  ogDescription="Lectura entre amigos. Mantén viva tu racha de días, compite con tus amigos y disfruta de la lectura."
>
  <Fragment slot="head">
    <meta name="apple-itunes-app" content="app-id=6808078003" />
    <style>
      .teaser {
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 70px 0 60px;
      }
      .teaser-inner {
        max-width: 560px;
        margin: 0 auto;
      }
      .teaser-mascot {
        width: 200px;
        height: auto;
        margin: 0 auto 40px;
        display: block;
      }
      //.streak-demo {
      //  display: inline-flex;
      //  align-items: center;
      //  gap: 10px;
      //  background: #1f293d;
