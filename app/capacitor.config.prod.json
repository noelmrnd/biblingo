{
  "appId": "me.biblingo.app",
  "appName": "Biblingo",
  "webDir": "dist-capacitor",
  "server": {
    "url": "https://app.biblingo.me",
    "cleartext": false,
    "allowNavigation": ["app.biblingo.me", "*.biblingo.me"],
    "errorPath": "offline.html"
  },
  "plugins": {
    "Preferences": {
      "group": "app"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
